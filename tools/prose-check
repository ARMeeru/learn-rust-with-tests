#!/usr/bin/env python3
"""Fail on em dashes, en dashes and curly quotes in book prose.

Fenced code blocks and inline code are stripped before scanning, so quoted
compiler output and code samples are never checked. Arguments are files or
directories (directories are searched for *.md); the default is book/src.
Exit 1 with one line per offending location.
"""

import re
import sys
from pathlib import Path

BANNED = {
    "\u2014": "em dash",
    "\u2013": "en dash",
    "\u2018": "curly single quote",
    "\u2019": "curly single quote",
    "\u201c": "curly double quote",
    "\u201d": "curly double quote",
}

FENCE = re.compile(r"^(```|~~~)")
INLINE_CODE = re.compile(r"`[^`\n]*`")


def prose_lines(text):
    """Yield (line_number, line) for lines outside fenced blocks, inline code removed."""
    in_fence = False
    for number, line in enumerate(text.splitlines(), start=1):
        if FENCE.match(line.strip()):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        yield number, INLINE_CODE.sub("", line)


def markdown_files(targets):
    for target in targets:
        path = Path(target)
        if path.is_dir():
            yield from sorted(path.rglob("*.md"))
        else:
            yield path


def main(targets):
    failures = 0
    for path in markdown_files(targets):
        for number, line in prose_lines(path.read_text(encoding="utf-8")):
            for char, name in BANNED.items():
                if char in line:
                    column = line.index(char) + 1
                    print(f"{path}:{number}:{column}: {name}")
                    failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:] or ["book/src"]))
